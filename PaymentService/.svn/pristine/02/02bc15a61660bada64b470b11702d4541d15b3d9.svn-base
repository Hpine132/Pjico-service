BROKER SCHEMA Version1.InquiryCommissionPayment.ESQLs


CREATE COMPUTE MODULE BuildResponse
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		DECLARE functionCode CHAR Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:ServiceBody.*[1].*:BodyReq.*:FunctionCode;
		SET OutputRoot.Properties=InputRoot.Properties;				
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.commonheader:Header = Environment.Variables.SOAVariables.*:SOAEnvelope.*:ServiceBody.*[1].*:Header;
		
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.commonheader:ResponseStatus.commonheader:Status = '0';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '000';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Successful';
		
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:AgencyCode = 'AAAA';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:Amount = '1100';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:CommissionAmount = '1000';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:Employee = 'Nguyễn Văn A';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:FeeVat = '100';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:MiningVehicle = 'Xe máy';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:PartyCode = 'Tổng công ty';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:PolicyNo = 'P-22/AAA/BBB/0000/000000';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:ProductCode = 'ABC';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:UnitCode = 'TCT';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:Voucher = 'A1234';
		SET OutputRoot.XMLNSC.ns:InquiryCommissionPaymentRes.ns:BodyRes.ns:VoucherDate = '13/07/2022';
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
