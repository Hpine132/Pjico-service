BROKER SCHEMA Version1.CalculateCarMaterial.ESQLs


CREATE COMPUTE MODULE BuildResponse
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		
		DECLARE functionCode CHAR Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:ServiceBody.*[1].*:BodyReq.*:FunctionCode;
		SET OutputRoot.Properties=InputRoot.Properties;				
		SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:Header = Environment.Variables.SOAVariables.*:SOAEnvelope.*:ServiceBody.*[1].*:Header;
		IF Environment.Variables.ServiceCallout.Status = '0' THEN
			DECLARE status CHARACTER InputRoot.XMLNSC;
			IF status = '0' THEN
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:Status = '0';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '000';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Successful';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.ns:BodyRes.ns:BasicCharge 
					= InputRoot.XMLNSC;
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.ns:BodyRes.ns:VATBasicCharge 
					= InputRoot.XMLNSC;
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.ns:BodyRes.ns:ChangeCharge 
					= InputRoot.XMLNSC;
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.ns:BodyRes.ns:VATChangeCharge 
					= InputRoot.XMLNSC;
			ELSE
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:Status = '1';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error in Backend';
				
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:SourceAppID = 'QRCODE';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode = Environment.Variables.ServiceCallout.Status;
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc = Environment.Variables.ServiceCallout.ResponseDetail.ErrorDesc;
			END IF;
		ELSE
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:Status = '1';
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error in Backend';
			
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:SourceAppID = 'QRCODE';
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode = Environment.Variables.ServiceCallout.Status;
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc = Environment.Variables.ServiceCallout.ResponseDetail.ErrorDesc;
		END IF;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
