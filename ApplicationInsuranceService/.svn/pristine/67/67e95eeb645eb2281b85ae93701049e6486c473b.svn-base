BROKER SCHEMA Version1.ProvideLifeInsurance.ESQLs

CREATE COMPUTE MODULE BuildResponse
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE functionCode CHAR Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:ServiceBody.*[1].*:BodyReq.*:FunctionCode;
		SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:Header = Environment.Variables.SOAVariables.*:SOAEnvelope.*:ServiceBody.*[1].*:Header;
		DECLARE callOutStatus CHARACTER Environment.Variables.ServiceCallout.Status;
		IF callOutStatus = '0' THEN
			DECLARE actcode  CHARACTER COALESCE(COALESCE(InputRoot.XML.XML.ACTCODE, InputRoot.XML.XML.POLICYDETAILS_RESPONSE.ACTCODE), InputRoot.XML.XML.ActCode);
			IF actcode = 'Y'  THEN
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:Status = '0';
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '000';
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Successful';
				
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:MessageType = InputRoot.XML.XML.MESSAGETYPE;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:ConfigID = InputRoot.XML.XML.CONFIG_ID;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:ProcCode = InputRoot.XML.XML.PROCCODE;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:Stan = InputRoot.XML.XML.STAN;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:LocalDateTime = InputRoot.XML.XML.LOCALTXNDTTIME;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:DeliveryChannel = InputRoot.XML.XML.DELIVERYCHANNELCTRLID;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:ActCode = InputRoot.XML.XML.ACTCODE;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:ActDesc = InputRoot.XML.XML.ACTDESCRIPTION;
				
			ELSE
				DECLARE ErrorDesc CHARACTER '';
				IF COALESCE(InputRoot.XML.XML.POLICYDETAILS_RESPONSE.ERRORS.ERROR.ERR_DESC, InputRoot.XML.XML.ERRORS.ERROR.ERR_DESC) IS NOT NULL THEN
					SET ErrorDesc = COALESCE(InputRoot.XML.XML.POLICYDETAILS_RESPONSE.ACTDESCRIPTION, COALESCE(InputRoot.XML.XML.ACTDESCRIPTION,InputRoot.XML.XML.ActDescription)) || ' - ' || COALESCE(InputRoot.XML.XML.POLICYDETAILS_RESPONSE.ERRORS.ERROR.ERR_DESC, InputRoot.XML.XML.ERRORS.ERROR.ERR_DESC) ;
				ELSE
					SET ErrorDesc = COALESCE(InputRoot.XML.XML.POLICYDETAILS_RESPONSE.ACTDESCRIPTION, COALESCE(InputRoot.XML.XML.ACTDESCRIPTION,InputRoot.XML.XML.ActDescription));
				END IF;
				
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:Status = '1';
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error to backend';
				
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:SourceAppID = 'PREMIA';
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode = actcode;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc = ErrorDesc;
				
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:MessageType = InputRoot.XML.XML.MESSAGETYPE;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:ConfigID = InputRoot.XML.XML.CONFIG_ID;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:ProcCode = InputRoot.XML.XML.PROCCODE;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:Stan = InputRoot.XML.XML.STAN;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:LocalDateTime = InputRoot.XML.XML.LOCALTXNDTTIME;
				SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:DeliveryChannel = InputRoot.XML.XML.DELIVERYCHANNELCTRLID;
				--SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:ActCode = InputRoot.XML.XML.ACTCODE;
				--SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:ActDesc = InputRoot.XML.XML.ACTDESCRIPTION;
				--SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.ns:BodyRes.ns:ErrDesc = InputRoot.XML.XML.POLICYDETAILS_RESPONSE.ERRORS.ERROR.ERR_DESC;
			END IF;
		
		ELSE
			SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:Status = '1';
			SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
			SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error to backend';
			
			SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:SourceAppID = 'PREMIA';
			SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode = callOutStatus;
			SET OutputRoot.XMLNSC.ns:ProvideLifeInsuranceRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc =  Environment.Variables.ServiceCallout.ResponseDetail.ErrorDesc;
			
		END IF;
		
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
