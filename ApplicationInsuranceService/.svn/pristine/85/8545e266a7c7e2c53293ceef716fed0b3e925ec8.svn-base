BROKER SCHEMA Version1.InquiryInsurance.ESQLs
DECLARE ns61 NAMESPACE 'http://www.pjico.com.vn/entity/vn/authentication/authenticationservice/1';

DECLARE UserNameQryInsurance EXTERNAL CHARACTER '';
DECLARE PasswordQryInsurance EXTERNAL CHARACTER '';
DECLARE GrantTypeQry EXTERNAL CHARACTER '';
DECLARE GetTokenUrl EXTERNAL CHARACTER '';
DECLARE GetTokenTimeout EXTERNAL CHARACTER '';
CREATE COMPUTE MODULE BuildReqGetToken
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		SET OutputRoot.Properties =InputRoot.Properties;
		SET OutputRoot.XMLNSC.ns61:GetTokenReq.commonheader:Header = InputRoot.XMLNSC.ns:InquiryInsuranceReq.commonheader:Header;
		SET OutputRoot.XMLNSC.ns61:GetTokenReq.ns61:BodyReq.ns61:FunctionCode = 'CUST-QRYCUS-REST-PREMIA';
		SET OutputRoot.XMLNSC.ns61:GetTokenReq.ns61:BodyReq.ns61:Username = UserNameQryInsurance;
		SET OutputRoot.XMLNSC.ns61:GetTokenReq.ns61:BodyReq.ns61:Password = PasswordQryInsurance;
		SET OutputRoot.XMLNSC.ns61:GetTokenReq.ns61:BodyReq.ns61:GrantType = GrantTypeQry;
	
		SET OutputLocalEnvironment.Destination.SOAP.Request.Transport.HTTP.WebServiceURL = GetTokenUrl; 
		SET OutputLocalEnvironment.Destination.SOAP.Request.Transport.HTTP.Timeout = GetTokenTimeout;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
