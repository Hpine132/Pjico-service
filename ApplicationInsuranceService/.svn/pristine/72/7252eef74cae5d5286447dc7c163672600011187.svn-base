        <namespace kind="supplement" prefix="io4" uri="http://www.pjico.com.vn/common/envelope/commonheader/1"/>
    </namespaces>
    <generation engine="xquery"/>
    <mappingDeclaration name="FunctionCodeNotMap">
        <input namespace="http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1" path="mb:msg(ProvideCarMaterialInsuranceReq,assembly,XMLNSC,Properties)" var="MessageAssembly"/>
        <output namespace="http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1" path="mb:msg(ProvideCarMaterialInsuranceRes,assembly,XMLNSC,Properties)" var="MessageAssembly1"/>
        <move>
            <input path="$MessageAssembly/Properties"/>
            <output path="$MessageAssembly1/Properties"/>
            <override>
                <assign value="{ESBMessageLib}">
