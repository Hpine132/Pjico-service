<?xml version="1.0" encoding="UTF-8"?><mappingRoot xmlns="http://www.ibm.com/2008/ccl/Mapping" domainID="com.ibm.msl.mapping.xml" domainIDExtension="mb" mainMap="true" targetNamespace="Version1.ProvideCarMaterialInsurance.Mappings" version="8.0.5.0" xmlns:map="Version1.ProvideCarMaterialInsurance.Mappings">
