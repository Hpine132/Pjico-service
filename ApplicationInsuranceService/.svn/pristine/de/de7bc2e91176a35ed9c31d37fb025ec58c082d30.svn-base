<?xml version="1.0" encoding="UTF-8"?><mappingRoot xmlns="http://www.ibm.com/2008/ccl/Mapping" domainID="com.ibm.msl.mapping.xml" domainIDExtension="mb" mainMap="true" targetNamespace="Version1.InquiryInsurance.Mappings" version="8.0.5.0" xmlns:map="Version1.InquiryInsurance.Mappings">
    <input path="jar:file://!com/ibm/etools/mft/map/xsds/assembly/Environment.xsd" var="var1"/>
    <input path="mbsharedlib://ESBMessageLib/service/vn/applicationinsurance/applicationinsuranceService.xsd" var="var2"/>
    <input path="mbsharedlib://ESBMessageLib/schema/Environment/EnvironmentVariables.xsd" var="var"/>
    <input path="mbsharedlib://ESBMessageLib/schema/Environment/EnvironmentVariables.xsd" var="var3"/>
    <output path="jar:file://!com/ibm/etools/mft/map/xsds/assembly/Environment.xsd" var="var4"/>
    <output path="mbsharedlib://ESBMessageLib/service/vn/applicationinsurance/applicationinsuranceService.xsd" var="var5"/>
    <namespaces>
        <namespace kind="supplement" prefix="io7" uri="http://www.pjico.com.vn/common/envelope/serviceenvelope/1"/>
        <namespace kind="supplement" prefix="io6" uri="http://www.pjico.com.vn/common/envelope/commonheader/1"/>
        <namespace kind="supplement" prefix="io9" uri="http://www.pjico.com.vn/entity/vn/com/isurance/1"/>
        <namespace kind="supplement" prefix="io8" uri="http://www.pjico.com.vn/entity/vn/com/account/1"/>
        <namespace kind="supplement" prefix="io" uri="http://www.pjico.com.vn/entity/vn/com/1"/>
        <namespace kind="supplement" prefix="io3" uri="http://www.pjico.com.vn/entity/vn/com/party/1"/>
        <namespace kind="supplement" prefix="io2" uri="http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1"/>
        <namespace kind="supplement" prefix="io5" uri="http://www.pjico.com.vn/common/envelope/soaenvelope/1"/>
        <namespace kind="supplement" prefix="io4" uri="http://www.pjico.com.vn/entity/vn/tax/1"/>
    </namespaces>
    <generation engine="xquery"/>
    <mappingDeclaration name="InquiryInsurance_MappingRes">
        <input path="$var1/mb:env(Environment)" var="Environment">
            <cast path="$Environment/Variables/any" qualifier="SOAVariables" ref="var" var="any"/>
            <cast path="$Environment/Variables/SOAVariables/SOAEnvelope/ServiceBody/any" qualifier="{http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1}InquiryInsuranceRes" ref="var2" var="any2"/>
        </input>
        <input namespace="http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1" path="$var2/mb:msg(InquiryInsuranceRes,assembly,XMLNSC,Properties)" var="MessageAssembly"/>
        <output path="$var4/mb:env(Environment)" var="Environment1">
            <cast path="$Environment1/Variables/any" qualifier="SOAVariables" ref="var" var="any1"/>
            <cast path="$Environment1/Variables/SOAVariables/SOAEnvelope/ServiceBody/any" qualifier="{http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1}InquiryInsuranceRes" ref="var5" var="any3"/>
        </output>
        <output namespace="http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1" path="$var5/mb:msg(InquiryInsuranceRes,assembly,XMLNSC,Properties)" var="MessageAssembly1"/>
        <passthrough>
            <input path="$Environment/."/>
            <output path="$Environment1/."/>
            <updates/>
        </passthrough>
        <move>
            <input path="$MessageAssembly/Properties"/>
            <output path="$MessageAssembly1/Properties"/>
            <override>
                <assign value="{ESBMessageLib}">
                    <output path="$MessageAssembly1/Properties/MessageSet"/>
                </assign>
            </override>
        </move>
        <local>
            <input path="$Environment/Variables/SOAVariables/SOAEnvelope/SOAServiceHeader/SOACommonDetail"/>
            <output path="$MessageAssembly1/InquiryInsuranceRes/Header/Common"/>
            <move>
                <input path="ServiceVersion"/>
                <output path="ServiceVersion"/>
            </move>
            <move>
                <input path="MessageId"/>
                <output path="MessageId"/>
            </move>
            <move>
                <input path="TransactionId"/>
                <output path="TransactionId"/>
            </move>
            <move>
                <input path="MessageTimestamp"/>
                <output path="MessageTimestamp"/>
            </move>
            <move>
                <input path="AdditionalInformation"/>
                <output path="AdditionalInformation"/>
            </move>
        </local>
        <local>
            <input path="$Environment/Variables/SOAVariables/SOAEnvelope/SOAServiceHeader/ClientDetail"/>
            <output path="$MessageAssembly1/InquiryInsuranceRes/Header/Client"/>
            <move>
                <input path="SourceAppID"/>
                <output path="SourceAppID"/>
            </move>
            <move>
                <input path="TargetAppIDs"/>
                <output path="TargetAppIDs"/>
            </move>
            <move>
                <input path="UserDetail"/>
                <output path="UserDetail"/>
            </move>
        </local>
        <local>
            <input path="$MessageAssembly/InquiryInsuranceRes/ResponseStatus"/>
            <output path="$MessageAssembly1/InquiryInsuranceRes/ResponseStatus"/>
            <move>
                <input path="Status"/>
                <output path="Status"/>
            </move>
            <move>
                <input path="GlobalErrorCode"/>
                <output path="GlobalErrorCode"/>
            </move>
            <move>
                <input path="GlobalErrorDescription"/>
                <output path="GlobalErrorDescription"/>
            </move>
            <foreach>
                <input path="ErrorInfo"/>
                <output path="ErrorInfo"/>
                <move>
                    <input path="SourceAppID"/>
                    <output path="SourceAppID"/>
                </move>
                <move>
                    <input path="ErrorCode"/>
                    <output path="ErrorCode"/>
                </move>
                <move>
                    <input path="ErrorDesc"/>
                    <output path="ErrorDesc"/>
                </move>
            </foreach>
        </local>
        <local>
            <input path="$MessageAssembly/InquiryInsuranceRes/BodyRes" var="BodyRes"/>
            <input auxiliary="true" path="$Environment/Variables/SOAVariables/SOAEnvelope/ServiceBody/InquiryInsuranceRes/BodyRes/FunctionCode" var="FunctionCode"/>
            <output path="$MessageAssembly1/InquiryInsuranceRes/BodyRes"/>
            <move>
                <input path="$FunctionCode/."/>
                <output path="FunctionCode"/>
            </move>
            <move>
                <input path="$BodyRes/PolicyInfo"/>
                <output path="PolicyInfo"/>
            </move>
            <move>
                <input path="$BodyRes/Party"/>
                <output path="Party"/>
            </move>
            <move>
                <input path="$BodyRes/RiskList"/>
                <output path="RiskList"/>
            </move>
        </local>
    </mappingDeclaration>
</mappingRoot>