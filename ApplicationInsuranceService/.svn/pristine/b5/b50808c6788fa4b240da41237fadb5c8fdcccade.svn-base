BROKER SCHEMA Version1.InquiryInsurance.ESQLs
DECLARE InquiryInsuranceUrl EXTERNAL CHARACTER '';
DECLARE InquiryInsuranceTimeout EXTERNAL CHARACTER'';
CREATE COMPUTE MODULE BuildReq
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		SET OutputRoot.Properties =InputRoot.Properties;
		DELETE FIELD OutputRoot.HTTPResponseHeader."content-encoding";	
		DECLARE bodyReqRef REFERENCE TO Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:ServiceBody.*[1].*:BodyReq;

		
		DECLARE TokenKey CHARACTER InputRoot.XMLNSC.ns61:GetTokenRes.ns61:BodyRes.ns61:AccessToken;
			IF TokenKey IS NOT NULL AND TokenKey <> '' THEN	
				--Set up BodyReq
				SET OutputRoot.HTTPRequestHeader."Content-Type"= 'application/json';
				SET OutputRoot.HTTPRequestHeader."Authorization" = 'Bearer '||TokenKey;
				
				DELETE FIELD OutputRoot.XMLNSC;
				SET OutputRoot.JSON.Data.POL_NO = bodyReqRef.InquiryValue;
				SET OutputRoot.JSON.Data.POL_SC_CODE = bodyReqRef.InquiryType;
				
				DECLARE addInfo reference to Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:SOAServiceHeader.soa:SOACommonDetail.commonheader:AdditionalInformation;
				DECLARE addIndx INTEGER CARDINALITY(Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:SOAServiceHeader.soa:SOACommonDetail.commonheader:AdditionalInformation.commonheader:NameValuePairs[]);
				SET addInfo.commonheader:NameValuePairs[addIndx+1].commonheader:Name = 'TARGETID';
				SET addInfo.commonheader:NameValuePairs[addIndx+1].commonheader:Value = 'PREMIA';
				
				SET addInfo.commonheader:NameValuePairs[addIndx+2].commonheader:Name = 'TARGETSERVICE';
				SET addInfo.commonheader:NameValuePairs[addIndx+2].commonheader:Value = 'INQUIRYINSURANCE';
				
				SET OutputLocalEnvironment.Destination.HTTP.RequestURL = InquiryInsuranceUrl;
				SET OutputLocalEnvironment.Destination.HTTP.Timeout = InquiryInsuranceTimeout;
				SET Environment.Variables.ServiceCallout.LogType = 'JSON';
				SET Environment.Variables.ServiceCallout.RequestType = 'POST';	
				
				PROPAGATE TO TERMINAL 'out1' FINALIZE NONE DELETE NONE;

				RETURN TRUE;
			ELSE 
				SET OutputRoot.XMLNSC.ns:InquiryInsuranceRes.commonheader:Header = InputRoot.XMLNSC.ns:InquiryInsuranceReq.commonheader:Header;
				SET OutputRoot.XMLNSC.ns:InquiryInsuranceRes.commonheader:ResponseStatus.commonheader:Status = '1';
				SET OutputRoot.XMLNSC.ns:InquiryInsuranceRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
				SET OutputRoot.XMLNSC.ns:InquiryInsuranceRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error to backend';
				
				SET OutputRoot.XMLNSC.ns:InquiryInsuranceRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:SourceAppID = 'PREMIA';
				SET OutputRoot.XMLNSC.ns:InquiryInsuranceRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode= 
					COALESCE(InputRoot.XMLNSC.ns61:GetTokenRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode,
				 	InputRoot.XMLNSC.ns61:GetTokenRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode);
				SET OutputRoot.XMLNSC.ns:InquiryInsuranceRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc =
				  	COALESCE(InputRoot.XMLNSC.ns61:GetTokenRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc,
				   	InputRoot.XMLNSC.ns61:GetTokenRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription);
				PROPAGATE TO TERMINAL 'out2' FINALIZE NONE DELETE NONE;
			END IF;
		RETURN FALSE;
	END;
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;