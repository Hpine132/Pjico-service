<?xml version="1.0" encoding="UTF-8"?><mappingRoot xmlns="http://www.ibm.com/2008/ccl/Mapping" domainID="com.ibm.msl.mapping.xml" domainIDExtension="mb" mainMap="true" targetNamespace="Version1.ProvideInsuranceBancas.Mappings" version="8.0.5.0" xmlns:map="Version1.ProvideInsuranceBancas.Mappings">
    <input path="mbsharedlib://ESBMessageLib/service/vn/applicationinsurance/applicationinsuranceService.xsd"/>
    <output path="mbsharedlib://ESBMessageLib/service/vn/applicationinsurance/applicationinsuranceService.xsd"/>
    <generation engine="xquery"/>
    <mappingDeclaration name="FunctionCodeNotMap">
        <input namespace="http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1" path="mb:msg(ProvideInsuranceBancasReq,assembly,XMLNSC,Properties)" var="MessageAssembly"/>
        <output namespace="http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1" path="mb:msg(ProvideInsuranceBancasRes,assembly,XMLNSC,Properties)" var="MessageAssembly1"/>
        <move>
            <input path="$MessageAssembly/Properties"/>
            <output path="$MessageAssembly1/Properties"/>
            <override>
                <assign value="{ESBMessageLib}">
                    <output path="$MessageAssembly1/Properties/MessageSet"/>
                </assign>
            </override>
        </move>
        <local>
            <input path="$MessageAssembly/ProvideInsuranceBancasReq/Header"/>
            <output path="$MessageAssembly1/ProvideInsuranceBancasRes/Header"/>
            <move>
                <input path="Common"/>
                <output path="Common"/>
            </move>
            <move>
                <input path="Client"/>
                <output path="Client"/>
            </move>
        </local>
        <assign value="1">
            <output path="$MessageAssembly1/ProvideInsuranceBancasRes/ResponseStatus/Status"/>
        </assign>
        <assign value="009">
            <output path="$MessageAssembly1/ProvideInsuranceBancasRes/ResponseStatus/GlobalErrorCode"/>
        </assign>
        <assign value="Function Code Not Map">
            <output path="$MessageAssembly1/ProvideInsuranceBancasRes/ResponseStatus/GlobalErrorDescription"/>
        </assign>
    </mappingDeclaration>
</mappingRoot>