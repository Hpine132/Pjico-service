BROKER SCHEMA Version1.InquiryInsuranceHealthCare.ESQLs

DECLARE ns NAMESPACE 'http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1';
DECLARE commonheader NAMESPACE 'http://www.pjico.com.vn/common/envelope/commonheader/1';
DECLARE soa NAMESPACE 'http://www.pjico.com.vn/common/envelope/soaenvelope/1';

DECLARE InquiryInsuranceHealthCareUrl EXTERNAL CHARACTER '';
DECLARE InquiryInsuranceHealthCareTimeout EXTERNAL CHARACTER '';

CREATE COMPUTE MODULE BuildRequestHealthCare
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		SET OutputRoot.Properties = InputRoot.Properties;
		DECLARE bodyReqRef REFERENCE TO InputRoot.XMLNSC.ns:InquiryInsuranceHealthcareReq.ns:BodyReq;
		
		DECLARE account CHAR bodyReqRef.ns:Account;
		
		DECLARE DataInquiryInsuranceHealthCare REFERENCE TO OutputRoot.JSON.DataInquiryInsuranceHealthCare;
		
		CALL Service.Utils.ESQLs.InputValidate(1, 'Account', account, true, true, 999, DataInquiryInsuranceHealthCare);
		
		DECLARE  ErrorDesc CHARACTER;
		SET ErrorDesc = Service.Utils.ESQLs.validateRequest(DataInquiryInsuranceHealthCare);
		DELETE FIELD OutputRoot.JSON.DataInquiryInsuranceHealthCare; 
		IF ErrorDesc <> 'OK' THEN
			SET OutputRoot.XMLNSC.ns:InquiryInsuranceHealthcareRes.commonheader:Header = InputRoot.XMLNSC.ns:InquiryInsuranceHealthcareRes.commonheader:Header;
			SET OutputRoot.XMLNSC.ns:InquiryInsuranceHealthcareRes.commonheader:ResponseStatus.commonheader:Status = '1';
			SET OutputRoot.XMLNSC.ns:InquiryInsuranceHealthcareRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
			SET OutputRoot.XMLNSC.ns:InquiryInsuranceHealthcareRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error In Backend';
			SET OutputRoot.XMLNSC.ns:InquiryInsuranceHealthcareRes.commonheader:ResponseStatus.commonheader:ErrorInfo[1].commonheader:SourceAppID = 'HEALTHCARE';
			SET OutputRoot.XMLNSC.ns:InquiryInsuranceHealthcareRes.commonheader:ResponseStatus.commonheader:ErrorInfo[1].commonheader:ErrorCode = '99';
			SET OutputRoot.XMLNSC.ns:InquiryInsuranceHealthcareRes.commonheader:ResponseStatus.commonheader:ErrorInfo[1].commonheader:ErrorDesc = 'Unknow Error';

			PROPAGATE TO TERMINAL 'out2' FINALIZE NONE DELETE NONE;
		ELSE
		
			DECLARE addInfo reference to Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:SOAServiceHeader.soa:SOACommonDetail.commonheader:AdditionalInformation;
			DECLARE addIndx INTEGER CARDINALITY(Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:SOAServiceHeader.soa:SOACommonDetail.commonheader:AdditionalInformation.commonheader:NameValuePairs[]);
			SET addInfo.commonheader:NameValuePairs[addIndx+1].commonheader:Name = 'TARGETID';
			SET addInfo.commonheader:NameValuePairs[addIndx+1].commonheader:Value = 'INQUIRYINSURANCEHEALTHCARE';
			
			SET addInfo.commonheader:NameValuePairs[addIndx+2].commonheader:Name = 'TARGETSERVICE';
			SET addInfo.commonheader:NameValuePairs[addIndx+2].commonheader:Value ='APPLICATIONINSURANCESERVICE';
			SET Environment.Variables.ServiceCallout.LogType = 'JSON';
		
			-- setup request 
			SET OutputRoot.HTTPRequestHeader."Content-Type" = 'application/json';
			SET OutputRoot.JSON.Data.Account = bodyReqRef.ns:Account;
			SET OutputRoot.JSON.Data.DepartmentCode = bodyReqRef.ns:DepartmentCode;
			SET OutputRoot.JSON.Data.FromDate = bodyReqRef.ns:FromDate;
			SET OutputRoot.JSON.Data.Goods = bodyReqRef.ns:Goods;
			SET OutputRoot.JSON.Data.MiningOfficer = bodyReqRef.ns:MiningOfficer;
			SET OutputRoot.JSON.Data.PartyCode = bodyReqRef.ns:PartyCode;
			SET OutputRoot.JSON.Data.PolicyType = bodyReqRef.ns:PolicyType;
			SET OutputRoot.JSON.Data.ProductGroup = bodyReqRef.ns:ProductGroup;
			SET OutputRoot.JSON.Data.Signal = bodyReqRef.ns:Signal;
			SET OutputRoot.JSON.Data.Status = bodyReqRef.ns:Status;
			SET OutputRoot.JSON.Data.ToDate = bodyReqRef.ns:ToDate;
			SET OutputRoot.JSON.Data.UnitCode = bodyReqRef.ns:UnitCode;
			
			
			SET OutputLocalEnvironment.Destination.HTTP.RequestURL = InquiryInsuranceHealthCareUrl; 
			SET OutputLocalEnvironment.Destination.HTTP.Timeout = InquiryInsuranceHealthCareTimeout;
			PROPAGATE TO TERMINAL 'out1' FINALIZE NONE DELETE NONE;	
		END IF;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
