BROKER SCHEMA Version1.ProvideInsuranceBancas.ESQLS


CREATE COMPUTE MODULE CarMaterialResponse
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		
		DECLARE functionCode CHAR Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:ServiceBody.*[1].*:BodyReq.*:FunctionCode;
		SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:Header = Environment.Variables.SOAVariables.*:SOAEnvelope.*:ServiceBody.*[1].*:Header;
		DECLARE callOutStatus CHARACTER Environment.Variables.ServiceCallout.Status;
		
		IF callOutStatus = '0' THEN
			IF InputRoot.JSON.Data.PolPremiaPolNo IS NOT NULL THEN 
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:Status = '0';
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '000';
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Sucessfull';
				
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.ns:BodyRes.ns:PolRemarks = InputRoot.JSON.Data.PolRemarks;
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.ns:BodyRes.ns:PolPremiaPolNo = InputRoot.JSON.Data.PolPremiaPolNo;
			ELSE
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:Status = '1';
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error to backend';
				
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:SourceAppID = 'BANCAS';
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode = '002';
				SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc = InputRoot.JSON.Data.ERROR;
			
			END IF;
			
		ELSE
			SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:Status = '1';
			SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
			SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error to backend';
			
			SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:SourceAppID = 'BANCAS';
			SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode = callOutStatus;
			SET OutputRoot.XMLNSC.ns:ProvideInsuranceBancasRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc = Environment.Variables.ServiceCallout.ResponseDetail.ErrorDesc;
			
		END IF;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
