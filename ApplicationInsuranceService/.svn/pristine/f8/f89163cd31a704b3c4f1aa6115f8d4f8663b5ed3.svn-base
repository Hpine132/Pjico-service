<?xml version="1.0" encoding="UTF-8"?><mappingRoot xmlns="http://www.ibm.com/2008/ccl/Mapping" domainID="com.ibm.msl.mapping.xml" domainIDExtension="mb" mainMap="true" targetNamespace="Version1.ProvideInsuranceBancas.Mappings" version="8.0.5.0" xmlns:map="Version1.ProvideInsuranceBancas.Mappings">
    <input path="jar:file://!com/ibm/etools/mft/map/xsds/assembly/Environment.xsd" var="var1"/>
    <input path="mbsharedlib://ESBMessageLib/service/vn/applicationinsurance/applicationinsuranceService.xsd" var="var2"/>
    <input path="mbsharedlib://ESBMessageLib/schema/Environment/EnvironmentVariables.xsd" var="var"/>
    <input path="mbsharedlib://ESBMessageLib/schema/Environment/EnvironmentVariables.xsd" var="var3"/>
    <output path="jar:file://!com/ibm/etools/mft/map/xsds/assembly/Environment.xsd" var="var4"/>
    <output path="mbsharedlib://ESBMessageLib/service/vn/applicationinsurance/applicationinsuranceService.xsd" var="var5"/>
    <generation engine="xquery"/>
    <mappingDeclaration name="CarMaterialErrorMapping">
        <input path="$var1/mb:env(Environment)" var="Environment">
            <cast path="$Environment/Variables/any" qualifier="SOAVariables" ref="var" var="any"/>
        </input>
        <input namespace="http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1" path="$var2/mb:msg(ProvideInsuranceBancasRes,assembly,XMLNSC,Properties)" var="MessageAssembly"/>
        <output path="$var4/mb:env(Environment)" var="Environment1">
            <cast path="$Environment1/Variables/any" qualifier="SOAVariables" ref="var" var="any1"/>
        </output>
        <output namespace="http://www.pjico.com.vn/entity/vn/applicationinsurance/applicationinsuranceservice/1" path="$var5/mb:msg(ProvideInsuranceBancasRes,assembly,XMLNSC,Properties)" var="MessageAssembly1"/>
        <passthrough>
            <input path="$Environment/."/>
            <output path="$Environment1/."/>
            <updates/>
        </passthrough>
        <move>
            <input path="$MessageAssembly/Properties"/>
            <output path="$MessageAssembly1/Properties"/>
            <override>
                <assign value="{ESBMessageLib}">
                    <output path="$MessageAssembly1/Properties/MessageSet"/>
                </assign>
            </override>
        </move>
        <local>
            <input path="$Environment/Variables/SOAVariables/SOAEnvelope/SOAServiceHeader/SOACommonDetail"/>
            <output path="$MessageAssembly1/ProvideInsuranceBancasRes/Header/Common"/>
            <move>
                <input path="ServiceVersion"/>
                <output path="ServiceVersion"/>
            </move>
            <move>
                <input path="MessageId"/>
                <output path="MessageId"/>
            </move>
            <move>
                <input path="TransactionId"/>
                <output path="TransactionId"/>
            </move>
            <move>
                <input path="MessageTimestamp"/>
                <output path="MessageTimestamp"/>
            </move>
            <move>
                <input path="AdditionalInformation"/>
                <output path="AdditionalInformation"/>
            </move>
        </local>
        <local>
            <input path="$Environment/Variables/SOAVariables/SOAEnvelope/SOAServiceHeader/ClientDetail"/>
            <output path="$MessageAssembly1/ProvideInsuranceBancasRes/Header/Client"/>
            <move>
                <input path="SourceAppID"/>
                <output path="SourceAppID"/>
            </move>
            <move>
                <input path="TargetAppIDs"/>
                <output path="TargetAppIDs"/>
            </move>
            <move>
                <input path="UserDetail"/>
                <output path="UserDetail"/>
            </move>
        </local>
        <local>
            <input path="$MessageAssembly/ProvideInsuranceBancasRes/ResponseStatus"/>
            <output path="$MessageAssembly1/ProvideInsuranceBancasRes/ResponseStatus"/>
            <move>
                <input path="Status"/>
                <output path="Status"/>
            </move>
            <move>
                <input path="GlobalErrorCode"/>
                <output path="GlobalErrorCode"/>
            </move>
            <move>
                <input path="GlobalErrorDescription"/>
                <output path="GlobalErrorDescription"/>
            </move>
            <move>
                <input path="ErrorInfo"/>
                <output path="ErrorInfo"/>
            </move>
        </local>
        <local>
            <input path="$MessageAssembly/ProvideInsuranceBancasRes/BodyRes"/>
            <output path="$MessageAssembly1/ProvideInsuranceBancasRes/BodyRes"/>
            <move>
                <input path="FunctionCode"/>
                <output path="FunctionCode"/>
            </move>
            <move>
                <input path="PolRemarks"/>
                <output path="PolRemarks"/>
            </move>
            <move>
                <input path="PolPremiaPolNo"/>
                <output path="PolPremiaPolNo"/>
            </move>
        </local>
    </mappingDeclaration>
</mappingRoot>