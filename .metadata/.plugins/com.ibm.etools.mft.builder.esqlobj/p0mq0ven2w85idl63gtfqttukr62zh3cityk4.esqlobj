CREATE COMPUTE MODULE BuildResponse
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		
		DECLARE functionCode CHAR Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:ServiceBody.*[1].*:BodyReq.*:FunctionCode;
		SET OutputRoot.Properties=InputRoot.Properties;
		SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:Header = Environment.Variables.SOAVariables.*:SOAEnvelope.*:ServiceBody.*[1].*:Header;
			
		IF Environment.Variables.ServiceCallout.Status = '0' THEN
			DECLARE result CHARACTER InputRoot.XMLNSC.ns14:GET_VCXECG_CHARGE_JSONResponse.ns14:GET_VCXECG_CHARGE_JSONResult;
			DECLARE status CHARACTER '0';
												
			IF result <> '[]' and result IS NOT NULL and result <> '' THEN
				DECLARE dataAsBit BIT  CAST(result AS BIT CCSID 1208);
				CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON' PARSE(dataAsBit CCSID 1208);
				
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:Status = '0';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '000';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Successful';
				
				DECLARE pattern CHARACTER '';
				DECLARE basicCharge CHARACTER ;
				DECLARE vatbasicCharge CHARACTER ;
				DECLARE changeCharge CHARACTER ;
				DECLARE vatchangeCharge CHARACTER ;
				SET basicCharge = CAST (OutputRoot.JSON.Data.Item.BASIC_CHARGE AS CHAR FORMAT pattern);
				SET vatbasicCharge = CAST (OutputRoot.JSON.Data.Item.VATBASIC_CHARGE AS CHAR FORMAT pattern);
				SET changeCharge = CAST (OutputRoot.JSON.Data.Item.CHANGE_CHARGE AS CHAR FORMAT pattern);
				SET vatchangeCharge = CAST (OutputRoot.JSON.Data.Item.VATCHANGE_CHARGE AS CHAR FORMAT pattern);
				 
--				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.ns:BodyRes.ns:Fee.acct:Amount = OutputRoot.JSON.Data.Item.BASIC_CHARGE;
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.ns:BodyRes.ns:Fee.acct:Amount = basicCharge;
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.ns:BodyRes.ns:Fee.acct:SumAmount = vatbasicCharge;
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.ns:BodyRes.ns:FeeChange.acct:Amount = changeCharge;
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.ns:BodyRes.ns:FeeChange.acct:SumAmount = vatchangeCharge;
--				
				DELETE FIELD OutputRoot.JSON;
			ELSEIF result = '[]' OR result IS NULL OR result = '' THEN
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:Status = '0';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '015';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'No data found';
--				
--			END IF;
			ELSE
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:Status = '1';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error in Backend';
				
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:SourceAppID = 'PREMIA';
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode = Environment.Variables.ServiceCallout.Status;
				SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc = Environment.Variables.ServiceCallout.ResponseDetail.ErrorDesc;
			END IF;
		ELSE
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:Status = '1';
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error in Backend';
			
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:SourceAppID = 'PREMIA';
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorCode = Environment.Variables.ServiceCallout.Status;
			SET OutputRoot.XMLNSC.ns:CalculateCarMaterialRes.commonheader:ResponseStatus.commonheader:ErrorInfo.commonheader:ErrorDesc = Environment.Variables.ServiceCallout.ResponseDetail.ErrorDesc;
		END IF;
		
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;