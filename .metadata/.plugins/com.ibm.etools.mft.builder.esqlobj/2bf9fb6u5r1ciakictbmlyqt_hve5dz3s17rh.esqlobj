CREATE COMPUTE MODULE BuildRequest
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		SET OutputRoot.Properties = InputRoot.Properties;
		DECLARE bodyReqRef REFERENCE TO InputRoot.XMLNSC.ns:InquiryBillReq.ns:BodyReq;
		
		DECLARE billNo CHAR bodyReqRef.ns:BillNo;
		
		DECLARE DataInquiryBill REFERENCE TO OutputRoot.JSON.DataInquiryBill;
		
		CALL Service.Utils.ESQLs.InputValidate(1, 'BillNo', billNo, true, true, 999, DataInquiryBill);
		
		DECLARE  ErrorDesc CHARACTER;
		SET ErrorDesc = Service.Utils.ESQLs.validateRequest(DataInquiryBill);
		DELETE FIELD OutputRoot.JSON.DataInquiryBill; 
		IF ErrorDesc <> 'OK' THEN
			SET OutputRoot.XMLNSC.ns:InquiryBillRess.commonheader:Header = InputRoot.XMLNSC.ns:InquiryBillRes.commonheader:Header;
			SET OutputRoot.XMLNSC.ns:InquiryBillRess.commonheader:ResponseStatus.commonheader:Status = '1';
			SET OutputRoot.XMLNSC.ns:InquiryBillRess.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '004';
			SET OutputRoot.XMLNSC.ns:InquiryBillRess.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Error In Backend';
			SET OutputRoot.XMLNSC.ns:InquiryBillRess.commonheader:ResponseStatus.commonheader:ErrorInfo[1].commonheader:SourceAppID = 'FTS';
			SET OutputRoot.XMLNSC.ns:InquiryBillRess.commonheader:ResponseStatus.commonheader:ErrorInfo[1].commonheader:ErrorCode = '99';
			SET OutputRoot.XMLNSC.ns:InquiryBillRess.commonheader:ResponseStatus.commonheader:ErrorInfo[1].commonheader:ErrorDesc = 'Unknow Error';

			PROPAGATE TO TERMINAL 'out2' FINALIZE NONE DELETE NONE;
		ELSE
		
			DECLARE addInfo reference to Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:SOAServiceHeader.soa:SOACommonDetail.commonheader:AdditionalInformation;
			DECLARE addIndx INTEGER CARDINALITY(Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:SOAServiceHeader.soa:SOACommonDetail.commonheader:AdditionalInformation.commonheader:NameValuePairs[]);
			SET addInfo.commonheader:NameValuePairs[addIndx+1].commonheader:Name = 'TARGETID';
			SET addInfo.commonheader:NameValuePairs[addIndx+1].commonheader:Value = 'INQUIRYBILL';
			
			SET addInfo.commonheader:NameValuePairs[addIndx+2].commonheader:Name = 'TARGETSERVICE';
			SET addInfo.commonheader:NameValuePairs[addIndx+2].commonheader:Value ='PAYMENTSERVICE';
			SET Environment.Variables.ServiceCallout.LogType = 'JSON';
		
			-- setup request 
			SET OutputRoot.HTTPRequestHeader."Content-Type" = 'application/json';
			SET OutputRoot.JSON.Data.BillNo = bodyReqRef.ns:BillNo;
			
			SET OutputLocalEnvironment.Destination.HTTP.RequestURL = InquiryBillUrl; 
			SET OutputLocalEnvironment.Destination.HTTP.Timeout = InquiryBillTimeout;
			PROPAGATE TO TERMINAL 'out1' FINALIZE NONE DELETE NONE;	
		END IF;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;