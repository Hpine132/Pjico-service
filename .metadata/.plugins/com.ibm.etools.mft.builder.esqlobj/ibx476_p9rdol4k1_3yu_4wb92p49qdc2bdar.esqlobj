/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		SET OutputRoot.Properties = InputRoot.Properties;
		DECLARE bodyReqRef REFERENCE TO InputRoot.XMLNSC.ns:CalculateCarResponsibilityReq.ns:BodyReq;
		DELETE FIELD OutputRoot.HTTPResponseHeader."content-encoding";
		
		DECLARE DataCalculateCarMaterial REFERENCE TO OutputRoot.JSON.DataCalculateCarMaterial;
		CALL Service.Utils.ESQLs.InputValidate(1, 'VEH_Type', bodyReqRef.ns:CarInfo.Type, true, true, 999, DataCalculateCarMaterial);
		CALL Service.Utils.ESQLs.InputValidate(2, 'VEH_Seats', bodyReqRef.ns:CarInfo.Seats, true, true, 999,  DataCalculateCarMaterial);
		CALL Service.Utils.ESQLs.InputValidate(3, 'VEH_Weight', bodyReqRef.ns:CarInfo.Weight, false, false, 999,  DataCalculateCarMaterial);
		
		CALL Service.Utils.ESQLs.InputValidate(4, 'UsePuporse', bodyReqRef.ns:UsePuporse, true, true, 999, DataCalculateCarMaterial);
		CALL Service.Utils.ESQLs.InputValidate(5, 'CompulsoryCivilLiability', bodyReqRef.ns:CompulsoryCivilLiability, true, true, 999, DataCalculateCarMaterial);
		CALL Service.Utils.ESQLs.InputValidate(6, 'VoluntaryCivilLiability', bodyReqRef.ns:VoluntaryCivilLiability, true, true, 999, DataCalculateCarMaterial);
		CALL Service.Utils.ESQLs.InputValidate(7, 'CivilLiabilityForGoods', bodyReqRef.ns:CivilLiabilityForGoods, false, false, 999, DataCalculateCarMaterial);
		CALL Service.Utils.ESQLs.InputValidate(8, 'OccupantAccident', bodyReqRef.ns:OccupantAccident, false, false, 999, DataCalculateCarMaterial);
		CALL Service.Utils.ESQLs.InputValidate(9, 'CoDriverAccident', bodyReqRef.ns:CoDriverAccident, false, false, 999, DataCalculateCarMaterial);

		DECLARE  ErrorDesc CHARACTER;
		SET ErrorDesc = Service.Utils.ESQLs.validateRequest(DataCalculateCarMaterial);
		DELETE FIELD OutputRoot.JSON.DataCalculateCarMaterial ; 
		IF ErrorDesc <> 'OK' THEN
			SET OutputRoot.XMLNSC.ns:CalculateCarResponsibilityRes.commonheader:Header = InputRoot.XMLNSC.ns:CalculateCarResponsibilityReq.commonheader:Header;
			SET OutputRoot.XMLNSC.ns:CalculateCarResponsibilityRes.commonheader:ResponseStatus.commonheader:Status = '1';
			SET OutputRoot.XMLNSC.ns:CalculateCarResponsibilityRes.commonheader:ResponseStatus.commonheader:GlobalErrorCode = '002';
			SET OutputRoot.XMLNSC.ns:CalculateCarResponsibilityRes.commonheader:ResponseStatus.commonheader:GlobalErrorDescription = 'Invalid input data';
			SET OutputRoot.XMLNSC.ns:CalculateCarResponsibilityRes.commonheader:ResponseStatus.commonheader:ErrorInfo[1].commonheader:SourceAppID = 'ESB';
			SET OutputRoot.XMLNSC.ns:CalculateCarResponsibilityRes.commonheader:ResponseStatus.commonheader:ErrorInfo[1].commonheader:ErrorCode = '002';
			SET OutputRoot.XMLNSC.ns:CalculateCarResponsibilityRes.commonheader:ResponseStatus.commonheader:ErrorInfo[1].commonheader:ErrorDesc = ErrorDesc;

			PROPAGATE TO TERMINAL 'out2' FINALIZE NONE DELETE NONE;
		--Build Request, set all field to call Jolt service
		ELSE 
			-- build req
			SET OutputRoot.XMLNSC.ns14:GET_POINT_TNDS_JSON.ns14:VEH_TYPE = bodyReqRef.ns:CarInfo.Type;
			SET OutputRoot.XMLNSC.ns14:GET_POINT_TNDS_JSON.ns14:SEATS = bodyReqRef.ns:CarInfo.Seats;
			SET OutputRoot.XMLNSC.ns14:GET_POINT_TNDS_JSON.ns14:WEIGHT = bodyReqRef.ns:CarInfo.Weight;
			SET OutputRoot.XMLNSC.ns14:GET_POINT_TNDS_JSON.ns14:USE_PURPOSE = bodyReqRef.ns:UsePuporse;
			SET OutputRoot.XMLNSC.ns14:GET_POINT_TNDS_JSON.ns14:TNDSBB = bodyReqRef.ns:CompulsoryCivilLiability;
			SET OutputRoot.XMLNSC.ns14:GET_POINT_TNDS_JSON.ns14:TNDSTN = bodyReqRef.ns:VoluntaryCivilLiability;
			SET OutputRoot.XMLNSC.ns14:GET_POINT_TNDS_JSON.ns14:TNDSHH = bodyReqRef.ns:CivilLiabilityForGoods;
			SET OutputRoot.XMLNSC.ns14:GET_POINT_TNDS_JSON.ns14:TNNN = bodyReqRef.ns:OccupantAccident;
			SET OutputRoot.XMLNSC.ns14:GET_POINT_TNDS_JSON.ns14:TNLP = bodyReqRef.ns:CoDriverAccident;
				
			DECLARE addInfo reference to Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:SOAServiceHeader.soa:SOACommonDetail.commonheader:AdditionalInformation;
			DECLARE addIndx INTEGER CARDINALITY(Environment.Variables.SOAVariables.soa:SOAEnvelope.soa:SOAServiceHeader.soa:SOACommonDetail.commonheader:AdditionalInformation.commonheader:NameValuePairs[]);
			SET addInfo.commonheader:NameValuePairs[addIndx+1].commonheader:Name = 'TARGETID';
			SET addInfo.commonheader:NameValuePairs[addIndx+1].commonheader:Value = 'PAYMENT';
			
			SET addInfo.commonheader:NameValuePairs[addIndx+2].commonheader:Name = 'TARGETSERVICE';
			SET addInfo.commonheader:NameValuePairs[addIndx+2].commonheader:Value = 'CalculateCarResponsibility';
			
			SET OutputLocalEnvironment.Destination.SOAP.Request.Transport.HTTP.WebServiceURL = CreatePaymentUrl; 
			SET OutputLocalEnvironment.Destination.SOAP.Request.Transport.HTTP.Timeout = CreatePaymentTimeout;		
			SET Environment.Variables.ServiceCallout.LogType = 'SOAP';
	--		DELETE FIELD OutputRoot.XMLNSC.DATA;
	--		DELETE FIELD OutputRoot.JSON;
			
			PROPAGATE TO TERMINAL 'out1' FINALIZE NONE DELETE NONE;
			RETURN TRUE;
		END IF;
		RETURN FALSE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
